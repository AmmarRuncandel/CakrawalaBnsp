-- ============================================================================
-- 0. PERSIAPAN DATABASE
-- ============================================================================
CREATE DATABASE IF NOT EXISTS db_perpustakaan;
USE db_perpustakaan;

-- Hapus tabel jika sudah ada (urutannya dibalik karena ada Foreign Key)
DROP TABLE IF EXISTS peminjaman;
DROP TABLE IF EXISTS buku;
DROP TABLE IF EXISTS anggota;
DROP TABLE IF EXISTS users;


-- ============================================================================
-- 1. PEMBUATAN STRUKTUR TABEL (DDL)
-- ============================================================================

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role ENUM('petugas', 'pengguna') NOT NULL DEFAULT 'pengguna',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE anggota (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    nama_lengkap VARCHAR(100) NOT NULL,
    nomor_telepon VARCHAR(15) NOT NULL,
    alamat TEXT,
    tanggal_bergabung DATE NOT NULL,
    CONSTRAINT fk_anggota_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE buku (
    id INT AUTO_INCREMENT PRIMARY KEY,
    judul VARCHAR(150) NOT NULL,
    penulis VARCHAR(100) NOT NULL,
    penerbit VARCHAR(100),
    tahun_terbit YEAR,
    stok INT NOT NULL DEFAULT 0,
    CONSTRAINT chk_stok_minimal CHECK (stok >= 0) 
);

CREATE TABLE peminjaman (
    id INT AUTO_INCREMENT PRIMARY KEY,
    anggota_id INT NOT NULL,
    buku_id INT NOT NULL,
    tanggal_pinjam DATE NOT NULL,
    tanggal_tenggat DATE NOT NULL, 
    tanggal_dikembalikan DATE DEFAULT NULL,
    status ENUM('dipinjam', 'dikembalikan') NOT NULL DEFAULT 'dipinjam',
    denda INT DEFAULT 0,
    CONSTRAINT fk_peminjaman_anggota FOREIGN KEY (anggota_id) REFERENCES anggota(id) ON DELETE CASCADE,
    CONSTRAINT fk_peminjaman_buku FOREIGN KEY (buku_id) REFERENCES buku(id) ON DELETE CASCADE
);


-- ============================================================================
-- 2. PEMBUATAN TRIGGER LOGIKA (Denda & Stok Otomatis)
-- ============================================================================
DELIMITER $$

CREATE TRIGGER trg_kurangi_stok_buku
AFTER INSERT ON peminjaman
FOR EACH ROW
BEGIN
    UPDATE buku SET stok = stok - 1 WHERE id = NEW.buku_id;
END$$

CREATE TRIGGER trg_tambah_stok_buku
AFTER UPDATE ON peminjaman
FOR EACH ROW
BEGIN
    IF NEW.status = 'dikembalikan' AND OLD.status = 'dipinjam' THEN
        UPDATE buku SET stok = stok + 1 WHERE id = NEW.buku_id;
    END IF;
END$$

CREATE TRIGGER trg_hitung_denda
BEFORE UPDATE ON peminjaman
FOR EACH ROW
BEGIN
    IF NEW.status = 'dikembalikan' AND OLD.status = 'dipinjam' THEN
        IF NEW.tanggal_dikembalikan > OLD.tanggal_tenggat THEN
            SET NEW.denda = DATEDIFF(NEW.tanggal_dikembalikan, OLD.tanggal_tenggat) * 1000;
        ELSE
            SET NEW.denda = 0;
        END IF;
    END IF;
END$$

DELIMITER ;


